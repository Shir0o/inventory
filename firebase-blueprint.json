{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "A piece of outreach literature or mission material.",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "description": "Stock Keeping Unit" },
        "title": { "type": "string", "description": "Title of the literature or material" },
        "subtitle": { "type": "string", "description": "Subtitle or edition details" },
        "category": { "type": "string", "enum": ["Bibles", "Tracts", "Booklets"] },
        "language": { "type": "string", "description": "Language of the material" },
        "unitPrice": { "type": "number", "description": "Cost per unit for valuation" },
        "stockLevel": { "type": "number" },
        "status": { "type": "string", "enum": ["Healthy", "Low", "Out"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "title", "category", "stockLevel", "status"]
    },
    "Event": {
      "title": "Distribution Event",
      "description": "An event where outreach materials are distributed.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "materialsDistributed": { "type": "number", "description": "Total count of materials distributed" },
        "status": { "type": "string", "enum": ["Scheduled", "Stock Alert", "Drafting", "Completed"] },
        "categoryStats": {
          "type": "object",
          "properties": {
            "bibles": { "type": "number" },
            "bibles_en": { "type": "number" },
            "bibles_es": { "type": "number" },
            "tracts": { "type": "number" },
            "tracts_en": { "type": "number" },
            "tracts_es": { "type": "number" },
            "booklets": { "type": "number" },
            "booklets_en": { "type": "number" },
            "booklets_es": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "date", "location", "materialsDistributed", "status"]
    },
    "EventMaterial": {
      "title": "Event Material",
      "description": "A specific inventory item assigned to an event.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "sku": { "type": "string" },
        "title": { "type": "string" },
        "language": { "type": "string" },
        "quantity": { "type": "number" },
        "preCount": { "type": "number" },
        "postCount": { "type": "number" },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "sku", "title", "quantity"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global configuration for the Lit-Ledger system.",
      "type": "object",
      "properties": {
        "orgName": { "type": "string" },
        "taxId": { "type": "string" },
        "address": { "type": "string" },
        "timezone": { "type": "string" },
        "updateFrequency": { "type": "string" },
        "warningThreshold": { "type": "number" },
        "criticalThreshold": { "type": "number" },
        "categories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "User": {
      "title": "User Profile",
      "description": "User account and role information.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Order": {
      "title": "Literature Order",
      "description": "Literature order item on reorder queue.",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "code": { "type": "string" },
        "qty": { "type": "number" },
        "packs": { "type": "number" },
        "orderedDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["key", "title", "code", "qty", "orderedDate"]
    }
  },
  "firestore": {
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Collection of inventory items."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of literature reorders."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of distribution events."
    },
    "/events/{eventId}/materials/{materialId}": {
      "schema": "EventMaterial",
      "description": "Sub-collection of materials distributed to a specific event."
    },
    "/settings/system": {
      "schema": "SystemSettings",
      "description": "Singleton document for system settings."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/authorized_emails/{email}": {
      "schema": { "type": "object", "properties": { "addedAt": { "type": "string" }, "addedBy": { "type": "string" } } },
      "description": "Whitelist of emails allowed to register."
    },
    "/audit_logs/{logId}": {
      "schema": { "type": "object", "properties": { "action": { "type": "string" }, "timestamp": { "type": "string" } } },
      "description": "System audit logs."
    },
    "/notifications/{notificationId}": {
      "schema": { "type": "object", "properties": { "type": { "type": "string" }, "read": { "type": "boolean" } } },
      "description": "User notifications."
    }
  }
}
