# Firebase API Key
VITE_FIREBASE_API_KEY=

# Gemini API Key for AI features (Prefix with VITE_ for client-side exposure)
VITE_GEMINI_API_KEY=

# Primary Admin Email (for initial setup and fallback)
VITE_PRIMARY_ADMIN_EMAIL=admin@example.com

# Optional: Sentry error tracking (production builds only). Leave empty to disable.
# Sentry → Project settings → Client Keys (DSN). Set it in the hosting build env.
VITE_SENTRY_DSN=
